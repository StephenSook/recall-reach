e/readReplay","tags":[],"type":"text","url":"/api/openapi/evidence/readReplay","content":"The rows /replay/{runId} shows. CPSC's public text and the demo shop's item titles, nothing about a buyer."},"25":{"id":"/api/openapi/evidence/recountReplay","page_id":"/api/openapi/evidence/recountReplay","type":"page","content":"Recount a Recall Replay's headline numbers from its own rows","breadcrumbs":["Docs","Home","API Reference","Evidence"],"tags":[],"url":"/api/openapi/evidence/recountReplay"},"26":{"id":"/api/openapi/evidence/recountReplay-0","page_id":"/api/openapi/evidence/recountReplay","tags":[],"type":"text","url":"/api/openapi/evidence/recountReplay","content":"Works the counts out again from the run's stored rows and compares them with the numbers it reported."},"27":{"id":"/api/openapi/status/health","page_id":"/api/openapi/status/health","type":"page","content":"Whether the site is working, check by check","breadcrumbs":["Docs","Home","API Reference","Status"],"tags":[],"url":"/api/openapi/status/health"},"28":{"id":"/api/openapi/status/health-0","page_id":"/api/openapi/status/health","tags":[],"type":"text","url":"/api/openapi/status/health","content":"Each check and the reading behind it. Never includes a secret or a database error's text."},"29":{"id":"/api/openapi/status/live","page_id":"/api/openapi/status/live","type":"page","content":"Whether the server answers. Touches no database.","breadcrumbs":["Docs","Home","API Reference","Status"],"tags":[],"url":"/api/openapi/status/live"},"30":{"id":"/api/openapi/status/live-0","page_id":"/api/openapi/status/live","tags":[],"type":"text","url":"/api/openapi/status/live","content":"For the host's health check. It says only that the server is up."}},"count":30},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":17,"2":2,"3":26,"4":7,"5":9,"6":8,"