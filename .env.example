# Copy to .env.local for `pnpm dev`. Placeholder values only; never commit real ones.

# Postgres connection string (Neon in production). Read by server/db/pg.ts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Anthropic API key, for the Claude check. Read by server/agent/claude.ts. Without it the app works and the queue
# says the check is unavailable.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Webhook ID shown on the PayPal sandbox app's Webhooks page. Read by app/api/paypal/webhook/route.ts.
PAYPAL_WEBHOOK_ID=YOUR_SANDBOX_WEBHOOK_ID

# PayPal SANDBOX app credentials (never live). Read by server/paypal/client.ts.
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET

# Optional shop subscriptions. Run scripts/subscription-plan.ts once against the same sandbox app, then keep its id.
# Without it the owner panel says subscriptions are not set up. Read by server/paypal/subscriptions.ts.
PAYPAL_SUBSCRIPTION_PLAN_ID=

# Optional: the PayPal SANDBOX platform app a real shop connects its own PayPal account to (Partner Referrals).
# Without these the queue says connecting isn't set up, and refunds stay with the demo's app. Read by
# server/paypal/platform.ts. The partner merchant id is the platform account's own, from the sandbox dashboard.
PAYPAL_PLATFORM_CLIENT_ID=YOUR_SANDBOX_PLATFORM_CLIENT_ID
PAYPAL_PLATFORM_CLIENT_SECRET=YOUR_SANDBOX_PLATFORM_CLIENT_SECRET
PAYPAL_PARTNER_MERCHANT_ID=YOUR_SANDBOX_PARTNER_MERCHANT_ID
# The platform app's webhook id. Its events post to the same webhook URL. Read by app/api/paypal/webhook/route.ts.
PAYPAL_PLATFORM_WEBHOOK_ID=YOUR_SANDBOX_PLATFORM_WEBHOOK_ID

# The shop's secret for HMAC keys over PayPal ids (at least 32 characters, random). PayPal ids are
# stored only as these keys. Read by server/privacy/recordKey.ts. Generate: openssl rand -hex 32
RECORD_HMAC_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Secrets for this app. Render generates these. Locally: openssl rand -hex 32
# Signs shop session cookies and family page links. Read by server/web/http.ts.
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Encrypts buyer email from a shop's own records, per shop. Read by server/web/http.ts.
SHOP_DATA_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Optional: a test inbox for the demo shop's notices. Without it, the seller adds the address.
DEMO_BUYER_EMAIL=
# Optional: a PayPal sandbox buyer for the past-window payment. Without it, that section doesn't show.
DEMO_PAYOUT_RECEIVER=

# AG Grid Enterprise licence, for the queue and Recall Replay tables. Without it they work and show AG's watermark.
AG_GRID_LICENSE_KEY=

# Set (to 1) where the daily Render Workflow refreshes Replay. Then the web service waits until Replay is 26 hours old
# before refreshing it itself; without it, a day.
REPLAY_VIA_WORKFLOW=

# AG Studio licence, for the recall dashboard. Without it the dashboard shows AG's watermark.
AG_STUDIO_LICENSE_KEY=

# Optional: Chrome's WebMCP origin-trial token, for /shopper's meta tag and response header. The header is set at build, so a new token needs a redeploy.
WEBMCP_ORIGIN_TRIAL_TOKEN=
