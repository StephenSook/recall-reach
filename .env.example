# Copy to .env.local for `pnpm dev`. Placeholder values only; never commit real ones.

# Postgres connection string (Neon in production). Read by server/db/pg.ts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Webhook ID shown on the PayPal sandbox app's Webhooks page. Read by app/api/paypal/webhook/route.ts.
PAYPAL_WEBHOOK_ID=YOUR_SANDBOX_WEBHOOK_ID
