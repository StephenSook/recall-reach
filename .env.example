# Copy to .env.local for `pnpm dev`. Placeholder values only; never commit real ones.

# Postgres connection string (Neon in production). Read by server/db/pg.ts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Webhook ID shown on the PayPal sandbox app's Webhooks page. Read by app/api/paypal/webhook/route.ts.
PAYPAL_WEBHOOK_ID=YOUR_SANDBOX_WEBHOOK_ID

# PayPal SANDBOX app credentials (never live). Read by server/paypal/client.ts.
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET

# The shop's secret for HMAC keys over PayPal ids (at least 32 characters, random). PayPal ids are
# stored only as these keys. Read by server/privacy/recordKey.ts. Generate: openssl rand -hex 32
RECORD_HMAC_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
